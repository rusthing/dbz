<a:ObjectID>A77E9603-A920-4B85-AA9E-52724778FF1E</a:ObjectID>
<a:Name>运行状态</a:Name>
<a:Code>run_status</a:Code>
<a:CreationDate>1791624230</a:CreationDate>
<a:Creator>张柏子</a:Creator>
<a:ModificationDate>1792402500</a:ModificationDate>
<a:Modifier>张柏子</a:Modifier>
<a:Comment>运行状态
@enum ConnectorRunStatus default=None
  0=None                无状态（刚添加记录）
  1=Running             运行中
  2=Disabled            已禁用
  3=KafkaConnectFailed  连接 KafkaConnect 失败
  4=RegisterFailed      注册连接器失败
  5=CheckFailed         检测连接器失败
  6=CheckError          检测连接器异常
