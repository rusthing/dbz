<a:Comment>连接器统一状态
@enum ConnectorRunStatus default=Unknown
  0=Unknown       未知
  1=Running       运行中
  2=Disabled      已停用
  3=Failed        失败
  4=NotDeployed   仅纳管未部署
  5=Unreachable   不可达（Connect 连不上，保留最后已知状态）
  6=Stopped       已停止（PAUSED / STOPPED）</a:Comment>
<a:DefaultValue>0</a:DefaultValue>
